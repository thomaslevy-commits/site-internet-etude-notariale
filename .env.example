# URL publique de l'outil externe de prise de rendez-vous (CLAUDE.md §2).
# Exemple : https://exemple-rendez-vous.fr/etude
NEXT_PUBLIC_BOOKING_URL=

# URL du service de paiement en ligne (CLAUDE.md §13, arbitrage n° 3).
# Vide tant qu'aucun prestataire n'est retenu et qu'aucun circuit
# d'encaissement n'est validé par le comptable taxateur : l'entrée
# « Paiement en ligne » de l'accueil n'apparaît pas. Périmètre : sommes dues
# à l'étude (émoluments, honoraires, débours, taxes afférentes) — jamais de
# fonds de dossier.
NEXT_PUBLIC_PAIEMENT_URL=

# URL canonique du site (sans barre oblique finale) — flux RSS, sitemap,
# canonicals et données structurées. Défaut en production : https://levy-notaires.fr
# (src/config/site.ts). Ne renseigner ici qu'en préproduction ou en local.
NEXT_PUBLIC_SITE_URL=
